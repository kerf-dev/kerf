# Rendered at container start by the nginx image's envsubst step (/etc/nginx/templates/conf.d → /tmp/conf.d,
# see nginx.conf).
# Variables: HUB_UPSTREAM (host:port of the hub API), REAL_IP_CONFIG (set by
# /docker-entrypoint.d/05-real-ip.envsh from TRUSTED_PROXIES), NGINX_LOCAL_RESOLVERS (from
# /etc/resolv.conf). Only variables defined in the environment are substituted, so nginx variables like
# $cookie_kerf_session stay as they are.

# Authentication (docs/auth.md): signing in is always required.
# - With a session cookie the browser is a signed-in user: forward only `kerf_session`, so the hub sees
#   exactly that user and role.
# - Without one, forward no credentials at all: the hub answers 401 to everything but sign-in, and the
#   UI shows its sign-in page.
# - `kerf_oidc` and `kerf_saml` (the state of a sign-in with the OpenID Connect or SAML identity
#   provider) are forwarded too: a sign-in only completes in the browser that started it.
# This proxy holds no token, and whatever the browser sends in Authorization is never forwarded.
map $cookie_kerf_session $hub_cookie_session {
    ""      "";
    default "kerf_session=$cookie_kerf_session; ";
}
map $cookie_kerf_oidc $hub_cookie_oidc {
    ""      "";
    default "kerf_oidc=$cookie_kerf_oidc; ";
}
map $cookie_kerf_saml $hub_cookie_saml {
    ""      "";
    default "kerf_saml=$cookie_kerf_saml";
}

server_tokens off;
gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_vary on;
gzip_types text/plain text/css application/json application/javascript application/problem+json image/svg+xml;

# Never log cookies or query strings with workload names.
log_format ro '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    access_log /var/log/nginx/access.log ro;

    # Client address behind a trusted load balancer or ingress controller (TRUSTED_PROXIES).
    ${REAL_IP_CONFIG}

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hub API, including /v1/auth/* (login sets the HttpOnly session cookie) and the admin writes
    # (X-CSRF-Token and If-Match are forwarded as sent).
    location /v1/ {
        limit_except GET HEAD POST PUT PATCH DELETE { deny all; }
        client_max_body_size 1m;

        # Resolve the hub at request time (it may start after this pod) and do not normalise the URI:
        # `$request_uri` is the raw request line, so a workload id's `%2F` reaches the hub undecoded
        # (hub.yaml: workload ids are one URL-encoded path segment).
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        resolver_timeout 3s;
        set $hub_upstream ${HUB_UPSTREAM};
        proxy_pass http://$hub_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $hub_upstream;
        # An empty value drops the header: the browser's own Authorization never reaches the hub, and
        # the hub sees no cookie but the session.
        proxy_set_header Authorization "";
        proxy_set_header Cookie "$hub_cookie_session$hub_cookie_oidc$hub_cookie_saml";
        # One entry, the client as nginx saw it (after TRUSTED_PROXIES): the hub rate-limits sign-ins by
        # the last X-Forwarded-For entry, so a client-sent header must not reach it.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_hide_header Access-Control-Allow-Origin;

        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # Fingerprinted build output: cache forever.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: every other path serves index.html; never cache it so new deploys load at once.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
