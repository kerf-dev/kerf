## ThrottleRatio
max by (cluster, namespace, workload_kind, workload, container) (
(
  sum by (cluster, namespace, pod, container) (label_replace(rate(container_cpu_cfs_throttled_periods_total{k8s_cluster="prod-eu1", env="prod", container!="", container!="POD"}[5m]), "cluster", "ro-spoke-2", "", ""))
  / clamp_min(sum by (cluster, namespace, pod, container) (label_replace(rate(container_cpu_cfs_periods_total{k8s_cluster="prod-eu1", env="prod", container!="", container!="POD"}[5m]), "cluster", "ro-spoke-2", "", "")), 1)
)
* on (cluster, namespace, pod) group_left (workload_kind, workload)
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="ReplicaSet"}, "cluster", "ro-spoke-2", "", ""), "replicaset", "$1", "owner_name", "(.*)")
