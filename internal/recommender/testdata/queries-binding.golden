## PodWorkload
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="ReplicaSet"}, "cluster", "ro-spoke-2", "", ""), "replicaset", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, replicaset) group_left (workload)
    max by (cluster, namespace, replicaset, workload) (
      label_replace(label_replace(kube_replicaset_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="Deployment"}, "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "Deployment", "workload", ".*"
)
or
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="Job"}, "cluster", "ro-spoke-2", "", ""), "job_name", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, job_name) group_left (workload)
    max by (cluster, namespace, job_name, workload) (
      label_replace(label_replace(kube_job_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="CronJob"}, "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "CronJob", "workload", ".*"
)
or
max by (cluster, namespace, pod, workload_kind, workload) (
  label_replace(
    label_replace(label_replace(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind=~"StatefulSet|DaemonSet"}, "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)"),
    "workload_kind", "$1", "owner_kind", "(.*)"
  )
)
)

## PodWorkload/filter+lastOver
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(last_over_time(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="ReplicaSet", namespace="shop"}[24h]), "cluster", "ro-spoke-2", "", ""), "replicaset", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, replicaset) group_left (workload)
    max by (cluster, namespace, replicaset, workload) (
      label_replace(label_replace(last_over_time(kube_replicaset_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="Deployment", namespace="shop"}[24h]), "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "Deployment", "workload", ".*"
)
or
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(last_over_time(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="Job", namespace="shop"}[24h]), "cluster", "ro-spoke-2", "", ""), "job_name", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, job_name) group_left (workload)
    max by (cluster, namespace, job_name, workload) (
      label_replace(label_replace(last_over_time(kube_job_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="CronJob", namespace="shop"}[24h]), "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "CronJob", "workload", ".*"
)
or
max by (cluster, namespace, pod, workload_kind, workload) (
  label_replace(
    label_replace(label_replace(last_over_time(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind=~"StatefulSet|DaemonSet", namespace="shop"}[24h]), "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)"),
    "workload_kind", "$1", "owner_kind", "(.*)"
  )
)
)

## CPUPerPod
sum by (cluster, namespace, pod, container) (label_replace(rate(container_cpu_usage_seconds_total{k8s_cluster="prod-eu1", env="prod", container!="", container!="POD"}[5m]), "cluster", "ro-spoke-2", "", ""))

## CPUPerPod/filter
sum by (cluster, namespace, pod, container) (label_replace(rate(container_cpu_usage_seconds_total{k8s_cluster="prod-eu1", env="prod", container!="", container!="POD", namespace="shop"}[5m]), "cluster", "ro-spoke-2", "", ""))

## MemoryPerPod
max by (cluster, namespace, pod, container) (label_replace(max_over_time(container_memory_working_set_bytes{k8s_cluster="prod-eu1", env="prod", container!="", container!="POD"}[5m]), "cluster", "ro-spoke-2", "", ""))

## CPUUsage/max
max by (cluster, namespace, workload_kind, workload, container) (
sum by (cluster, namespace, pod, container) (label_replace(rate(container_cpu_usage_seconds_total{k8s_cluster="prod-eu1", env="prod", container!="", container!="POD"}[5m]), "cluster", "ro-spoke-2", "", ""))
* on (cluster, namespace, pod) group_left (workload_kind, workload)
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="ReplicaSet"}, "cluster", "ro-spoke-2", "", ""), "replicaset", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, replicaset) group_left (workload)
    max by (cluster, namespace, replicaset, workload) (
      label_replace(label_replace(kube_replicaset_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="Deployment"}, "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "Deployment", "workload", ".*"
)
or
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="Job"}, "cluster", "ro-spoke-2", "", ""), "job_name", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, job_name) group_left (workload)
    max by (cluster, namespace, job_name, workload) (
      label_replace(label_replace(kube_job_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="CronJob"}, "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "CronJob", "workload", ".*"
)
or
max by (cluster, namespace, pod, workload_kind, workload) (
  label_replace(
    label_replace(label_replace(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind=~"StatefulSet|DaemonSet"}, "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)"),
    "workload_kind", "$1", "owner_kind", "(.*)"
  )
)
)
)

