## OOMKills
max by (cluster, namespace, workload_kind, workload, container) (
(
  (
    max by (cluster, namespace, pod, container) (label_replace(max_over_time(kube_pod_container_status_last_terminated_reason{k8s_cluster="prod-eu1", env="prod", reason="OOMKilled"}[24h]), "cluster", "ro-spoke-2", "", ""))
    and on (cluster, namespace, pod, container)
    (max by (cluster, namespace, pod, container) (label_replace(increase(kube_pod_container_status_restarts_total{k8s_cluster="prod-eu1", env="prod"}[24h]), "cluster", "ro-spoke-2", "", "")) > 0)
  )
  or
  (max by (cluster, namespace, pod, container) (label_replace(increase(container_oom_events_total{k8s_cluster="prod-eu1", env="prod", container!="", container!="POD"}[24h]), "cluster", "ro-spoke-2", "", "")) > 0)
)
* on (cluster, namespace, pod) group_left (workload_kind, workload)
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(last_over_time(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="ReplicaSet"}[24h]), "cluster", "ro-spoke-2", "", ""), "replicaset", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, replicaset) group_left (workload)
    max by (cluster, namespace, replicaset, workload) (
      label_replace(label_replace(last_over_time(kube_replicaset_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="Deployment"}[24h]), "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "Deployment", "workload", ".*"
)
or
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(label_replace(last_over_time(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="Job"}[24h]), "cluster", "ro-spoke-2", "", ""), "job_name", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, job_name) group_left (workload)
    max by (cluster, namespace, job_name, workload) (
      label_replace(label_replace(last_over_time(kube_job_owner{k8s_cluster="prod-eu1", env="prod", owner_kind="CronJob"}[24h]), "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "CronJob", "workload", ".*"
)
or
max by (cluster, namespace, pod, workload_kind, workload) (
  label_replace(
    label_replace(label_replace(last_over_time(kube_pod_owner{k8s_cluster="prod-eu1", env="prod", owner_kind=~"StatefulSet|DaemonSet"}[24h]), "cluster", "ro-spoke-2", "", ""), "workload", "$1", "owner_name", "(.*)"),
    "workload_kind", "$1", "owner_kind", "(.*)"
  )
)
)
)

