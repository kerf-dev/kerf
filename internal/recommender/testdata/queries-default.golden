## OOMKills
max by (cluster, namespace, workload_kind, workload, container) (
(
  (
    max by (cluster, namespace, pod, container) (max_over_time(kube_pod_container_status_last_terminated_reason{cluster="ro-spoke-1", reason="OOMKilled"}[24h]))
    and on (cluster, namespace, pod, container)
    (max by (cluster, namespace, pod, container) (increase(kube_pod_container_status_restarts_total{cluster="ro-spoke-1"}[24h])) > 0)
  )
  or
  (max by (cluster, namespace, pod, container) (increase(container_oom_events_total{cluster="ro-spoke-1", container!="", container!="POD"}[24h])) > 0)
)
* on (cluster, namespace, pod) group_left (workload_kind, workload)
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind="ReplicaSet"}[24h]), "replicaset", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, replicaset) group_left (workload)
    max by (cluster, namespace, replicaset, workload) (
      label_replace(last_over_time(kube_replicaset_owner{cluster="ro-spoke-1", owner_kind="Deployment"}[24h]), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "Deployment", "workload", ".*"
)
or
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind="Job"}[24h]), "job_name", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, job_name) group_left (workload)
    max by (cluster, namespace, job_name, workload) (
      label_replace(last_over_time(kube_job_owner{cluster="ro-spoke-1", owner_kind="CronJob"}[24h]), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "CronJob", "workload", ".*"
)
or
max by (cluster, namespace, pod, workload_kind, workload) (
  label_replace(
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind=~"StatefulSet|DaemonSet"}[24h]), "workload", "$1", "owner_name", "(.*)"),
    "workload_kind", "$1", "owner_kind", "(.*)"
  )
)
)
)

