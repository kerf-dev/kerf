max by (cluster, namespace, workload_kind, workload, container, image) (
max by (cluster, namespace, pod, container, image) (last_over_time(kube_pod_container_info{cluster="ro-spoke-1"}[24h]))
* on (cluster, namespace, pod) group_left (workload_kind, workload)
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind="ReplicaSet"}[24h]), "replicaset", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, replicaset) group_left (workload)
    max by (cluster, namespace, replicaset, workload) (
      label_replace(last_over_time(kube_replicaset_owner{cluster="ro-spoke-1", owner_kind="Deployment"}[24h]), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "Deployment", "workload", ".*"
)
or
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind="Job"}[24h]), "job_name", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, job_name) group_left (workload)
    max by (cluster, namespace, job_name, workload) (
      label_replace(last_over_time(kube_job_owner{cluster="ro-spoke-1", owner_kind="CronJob"}[24h]), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "CronJob", "workload", ".*"
)
or
max by (cluster, namespace, pod, workload_kind, workload) (
  label_replace(
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind=~"StatefulSet|DaemonSet"}[24h]), "workload", "$1", "owner_name", "(.*)"),
    "workload_kind", "$1", "owner_kind", "(.*)"
  )
)
)
)

## HPAInfo
max by (cluster, namespace, horizontalpodautoscaler, scaletargetref_kind, scaletargetref_name) (last_over_time(kube_horizontalpodautoscaler_info{cluster="ro-spoke-1"}[24h]))

## HPAMetrics
max by (cluster, namespace, horizontalpodautoscaler, metric_name, metric_target_type) (last_over_time(kube_horizontalpodautoscaler_spec_target_metric{cluster="ro-spoke-1"}[24h]))

## HPAReplicaBounds/min
max by (cluster, namespace, horizontalpodautoscaler) (last_over_time(kube_horizontalpodautoscaler_spec_min_replicas{cluster="ro-spoke-1"}[24h]))

## HPAPeakReplicas
max by (cluster, namespace, horizontalpodautoscaler) (max_over_time(kube_horizontalpodautoscaler_status_current_replicas{cluster="ro-spoke-1"}[168h]))

## Pricing/avg
avg by (cluster) (max by (cluster, node) (last_over_time(ro_cpu_core_hourly_cost_usd{cluster="ro-spoke-1"}[1h])))

## Pricing/count
count by (cluster) (max by (cluster, node) (last_over_time(ro_cpu_core_hourly_cost_usd{cluster="ro-spoke-1"}[1h])))

