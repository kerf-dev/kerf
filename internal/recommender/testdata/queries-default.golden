## ThrottleRatio
max by (cluster, namespace, workload_kind, workload, container) (
(
  sum by (cluster, namespace, pod, container) (rate(container_cpu_cfs_throttled_periods_total{cluster="ro-spoke-1", container!="", container!="POD"}[5m]))
  / clamp_min(sum by (cluster, namespace, pod, container) (rate(container_cpu_cfs_periods_total{cluster="ro-spoke-1", container!="", container!="POD"}[5m])), 1)
)
* on (cluster, namespace, pod) group_left (workload_kind, workload)
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(kube_pod_owner{cluster="ro-spoke-1", owner_kind="ReplicaSet"}, "replicaset", "$1", "owner_name", "(.*)")
