## PodWorkload
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(kube_pod_owner{cluster="ro-spoke-1", owner_kind="ReplicaSet"}, "replicaset", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, replicaset) group_left (workload)
    max by (cluster, namespace, replicaset, workload) (
      label_replace(kube_replicaset_owner{cluster="ro-spoke-1", owner_kind="Deployment"}, "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "Deployment", "workload", ".*"
)
or
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(kube_pod_owner{cluster="ro-spoke-1", owner_kind="Job"}, "job_name", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, job_name) group_left (workload)
    max by (cluster, namespace, job_name, workload) (
      label_replace(kube_job_owner{cluster="ro-spoke-1", owner_kind="CronJob"}, "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "CronJob", "workload", ".*"
)
or
max by (cluster, namespace, pod, workload_kind, workload) (
  label_replace(
    label_replace(kube_pod_owner{cluster="ro-spoke-1", owner_kind=~"StatefulSet|DaemonSet"}, "workload", "$1", "owner_name", "(.*)"),
    "workload_kind", "$1", "owner_kind", "(.*)"
  )
)
)

## PodWorkload/filter+lastOver
(
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind="ReplicaSet", namespace="shop"}[24h]), "replicaset", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, replicaset) group_left (workload)
    max by (cluster, namespace, replicaset, workload) (
      label_replace(last_over_time(kube_replicaset_owner{cluster="ro-spoke-1", owner_kind="Deployment", namespace="shop"}[24h]), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "Deployment", "workload", ".*"
)
or
label_replace(
  max by (cluster, namespace, pod, workload) (
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind="Job", namespace="shop"}[24h]), "job_name", "$1", "owner_name", "(.*)")
    * on (cluster, namespace, job_name) group_left (workload)
    max by (cluster, namespace, job_name, workload) (
      label_replace(last_over_time(kube_job_owner{cluster="ro-spoke-1", owner_kind="CronJob", namespace="shop"}[24h]), "workload", "$1", "owner_name", "(.*)")
    )
  ),
  "workload_kind", "CronJob", "workload", ".*"
)
or
max by (cluster, namespace, pod, workload_kind, workload) (
  label_replace(
    label_replace(last_over_time(kube_pod_owner{cluster="ro-spoke-1", owner_kind=~"StatefulSet|DaemonSet", namespace="shop"}[24h]), "workload", "$1", "owner_name", "(.*)"),
    "workload_kind", "$1", "owner_kind", "(.*)"
  )
)
)

## CPUPerPod
sum by (cluster, namespace, pod, container) (rate(container_cpu_usage_seconds_total{cluster="ro-spoke-1", container!="", container!="POD"}[5m]))

## CPUPerPod/filter
sum by (cluster, namespace, pod, container) (rate(container_cpu_usage_seconds_total{cluster="ro-spoke-1", container!="", container!="POD", namespace="shop"}[5m]))

## MemoryPerPod
max by (cluster, namespace, pod, container) (max_over_time(container_memory_working_set_bytes{cluster="ro-spoke-1", container!="", container!="POD"}[5m]))

