{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadKerfSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-1:123456789012:secret:kerf/*"
    }
  ]
}
