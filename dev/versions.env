# Pinned versions for the local dev environment. Sourced by dev/scripts/*.sh and the Tiltfile.
# Bump deliberately; never use floating tags.

# --- k3d / k3s -------------------------------------------------------------------------------------
K3S_IMAGE=rancher/k3s:v1.35.10-k3s1

# --- Helm charts -----------------------------------------------------------------------------------
VM_REPO=https://victoriametrics.github.io/helm-charts/
VM_SINGLE_CHART_VERSION=0.50.0          # VictoriaMetrics v1.155.0
VM_AGENT_CHART_VERSION=0.51.0           # vmagent v1.155.0
GRAFANA_REPO=https://grafana-community.github.io/helm-charts
GRAFANA_CHART_VERSION=14.3.1            # Grafana 13.3.0
KSM_REPO=https://prometheus-community.github.io/helm-charts
KSM_CHART_VERSION=8.8.0                 # kube-state-metrics v2.20.0
CERT_MANAGER_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION=v1.21.3
ARGOCD_REPO=https://argoproj.github.io/argo-helm
ARGOCD_CHART_VERSION=10.11.7            # Argo CD v3.5.7

# --- Plain images (manifests in dev/manifests and dev/workloads reference these exact tags) ----------
POSTGRES_IMAGE=postgres:18.6-alpine3.23
GIT_IMAGE=quay.io/argoproj/argocd:v3.5.7   # git server on spoke-1: same image as Argo CD (has git-daemon)
STRESS_NG_IMAGE=colinianking/stress-ng:77b17fb95ec2f00e1c2ac2a8a20fe799150d8bd5
JDK_IMAGE=eclipse-temurin:21.0.13_9-jdk-alpine-3.23
PYTHON_IMAGE=python:3.13.18-alpine3.23
BUSYBOX_IMAGE=busybox:1.37.0-musl
REGISTRY_IMAGE=registry:3.0.0
# Dex (dev OIDC provider, dev/manifests/hub/dex.yaml). Not v2.46.x: a refresh deadlocks its memory storage.
DEX_IMAGE=ghcr.io/dexidp/dex:v2.45.1@sha256:8499afd690c437f52301efd2b05b2455da5bd2dfc20332cd697dc9937f808462
